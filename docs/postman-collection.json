{
  "info": {
    "name": "Weduu - Desafio Webhook",
    "description": "COMO USAR: (1) npm start e ngrok http 4000 abertos; (2) importe esta coleção; (3) clique com o botão direito na pasta \"A. Fluxo automático\" > Run folder (ou use o Runner) e execute em ordem. Os passos 0 a 5 pegam a URL do ngrok, registram, pedem o lote, descobrem um SKU real e testam /enrich e /callback sozinhos. A pasta B tem as rotas do seu serviço para testar uma a uma.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "platformUrl",
      "value": "https://dev-wdu-ped-test-1014944555984.us-central1.run.app"
    },
    {
      "key": "webhookUrl",
      "value": ""
    },
    {
      "key": "cid",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "run_id",
      "value": "r1"
    },
    {
      "key": "sku",
      "value": ""
    },
    {
      "key": "price",
      "value": "0"
    },
    {
      "key": "stock",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "A. Fluxo automático (rodar em ordem)",
      "item": [
        {
          "name": "0. Pegar a URL do ngrok",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = (pm.response.json().tunnels || []).find(x => x.public_url.startsWith('https://'));",
                  "pm.test('ngrok aberto (rode: ngrok http 4000)', () => pm.expect(t).to.exist);",
                  "if (t) pm.collectionVariables.set('webhookUrl', t.public_url);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://127.0.0.1:4040/api/tunnels",
            "description": "Lê a URL pública do ngrok na API local dele (porta 4040) e grava em webhookUrl. O ngrok e o npm start precisam estar abertos."
          }
        },
        {
          "name": "1. POST /register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('cid', j.cid);",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{platformUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Frederyco\",\n  \"webhook\": \"{{webhookUrl}}\"\n}"
            }
          }
        },
        {
          "name": "2. POST /burst/:cid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('lote de 20', () => pm.expect(pm.response.json().total).to.eql(20));",
                  "pm.collectionVariables.set('run_id', pm.response.json().run_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-token",
                "value": "{{token}}"
              }
            ],
            "url": "{{platformUrl}}/burst/{{cid}}"
          }
        },
        {
          "name": "3. Pegar um SKU real no meu serviço (GET /runs/:id)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// espera as mensagens do lote chegarem ao serviço",
                  "setTimeout(function () {}, 4000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('as mensagens chegaram ao serviço', () => pm.expect(j.received).to.be.above(0));",
                  "pm.test('há SKUs de exemplo', () => pm.expect(j.sample_skus.length).to.be.above(0));",
                  "pm.collectionVariables.set('sku', j.sample_skus[0]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/runs/{{run_id}}",
            "description": "O serviço guarda os SKUs recebidos em /process. Este request lê o primeiro e grava em sku."
          }
        },
        {
          "name": "4. GET /enrich/:sku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('traz preço e estoque', () => { pm.expect(j.price).to.be.a('number'); pm.expect(j.stock).to.be.a('number'); });",
                  "pm.collectionVariables.set('price', j.price);",
                  "pm.collectionVariables.set('stock', j.stock);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-cid",
                "value": "{{cid}}"
              },
              {
                "key": "x-token",
                "value": "{{token}}"
              }
            ],
            "url": "{{platformUrl}}/enrich/{{sku}}",
            "description": "Latência esperada de 400 a 800 ms. 429 e 500 também são respostas do contrato (limite de 3 em voo e ~10% de falha transitória): se aparecerem, rode de novo."
          }
        },
        {
          "name": "5. POST /callback",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('relatório com score', () => pm.expect(r.score).to.be.a('number'));",
                  "console.log(JSON.stringify(r, null, 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-token",
                "value": "{{token}}"
              }
            ],
            "url": "{{platformUrl}}/callback",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cid\": \"{{cid}}\",\n  \"run_id\": \"{{run_id}}\",\n  \"result\": [\n    { \"seq\": 0, \"sku\": \"{{sku}}\", \"price\": {{price}}, \"stock\": {{stock}} }\n  ]\n}"
            },
            "description": "Envia 1 item real (o do passo 4). O relatório vai mostrar os outros 19 como faltando; serve para ver o formato da resposta. O envio completo com score 100 é feito pelo serviço (npm run demo:real). Veja o corpo completo no Console do Postman."
          }
        }
      ]
    },
    {
      "name": "B. Rotas do meu serviço (manual)",
      "item": [
        {
          "name": "POST /check - ecoa o token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve o mesmo token', () => pm.expect(pm.response.json().token).to.eql('abc123'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"abc123\"\n}"
            },
            "url": "{{baseUrl}}/check"
          }
        },
        {
          "name": "POST /process - mensagem nova (ACK rápido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.test('ACK abaixo de 600 ms', () => pm.expect(pm.response.responseTime).to.be.below(600));",
                  "pm.test('não é duplicata', () => pm.expect(pm.response.json().duplicate).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run_id\": \"{{run_id}}\",\n  \"seq\": 0,\n  \"sku\": \"sku-001\"\n}"
            },
            "url": "{{baseUrl}}/process"
          }
        },
        {
          "name": "POST /process - repetir a mesma mensagem (duplicata)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx mesmo sendo duplicata', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.test('marcada como duplicata', () => pm.expect(pm.response.json().duplicate).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run_id\": \"{{run_id}}\",\n  \"seq\": 0,\n  \"sku\": \"sku-001\"\n}"
            },
            "url": "{{baseUrl}}/process"
          }
        },
        {
          "name": "POST /process - corpo inválido (espera 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run_id\": \"{{run_id}}\"\n}"
            },
            "url": "{{baseUrl}}/process"
          }
        },
        {
          "name": "GET /runs/:id - estado do lote",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/runs/{{run_id}}"
          }
        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "POST /burst - gatilho local (precisa estar registrado)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/burst"
          }
        }
      ]
    }
  ]
}