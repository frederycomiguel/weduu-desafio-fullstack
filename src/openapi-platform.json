{
  "openapi": "3.0.3",
  "info": {
    "title": "Plataforma Weduu (rotas consumidas pelo serviço)",
    "version": "1.0.0",
    "description": "Rotas da plataforma Weduu que o nosso serviço CHAMA (o contrato está na Documentação Técnica da Integração). Elas não existem neste servidor. Observação: a plataforma não envia cabeçalhos de CORS, então o navegador bloqueia o botão \"Try it out\" daqui; para testá-las à mão use a coleção do Postman (docs/postman-collection.json, pasta \"2. Plataforma Weduu (real)\")."
  },
  "servers": [{ "url": "https://dev-wdu-ped-test-1014944555984.us-central1.run.app", "description": "Plataforma Weduu" }],
  "tags": [
    { "name": "Consumidas", "description": "Chamadas feitas pelo serviço à plataforma" }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["Consumidas"],
        "summary": "Registra o webhook",
        "description": "A plataforma chama `POST <webhook>/check` com o token e exige que ele seja devolvido. Se der certo, responde com `cid` e `token`, usados em todas as chamadas seguintes.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name", "webhook"], "properties": {
            "name": { "type": "string", "example": "Seu Nome" },
            "webhook": { "type": "string", "example": "https://xxxx.ngrok.app" }
          } } } }
        },
        "responses": {
          "200": { "description": "Registrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
          "422": { "description": "Handshake falhou", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "error": { "type": "string", "example": "handshake_failed" },
            "reason": { "type": "string" }
          } } } } }
        }
      }
    },
    "/burst/{cid}": {
      "post": {
        "tags": ["Consumidas"],
        "summary": "Solicita um novo lote",
        "description": "Depois de responder, a plataforma envia as mensagens ao nosso `POST /process`. Cada execução gera novos SKUs e um novo `run_id`.",
        "parameters": [
          { "name": "cid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "x-token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Lote criado", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "run_id": { "type": "string" },
            "total": { "type": "integer", "example": 20 },
            "started_at": { "type": "string", "format": "date-time" }
          } } } } },
          "401": { "description": "Credencial inválida" }
        }
      }
    },
    "/enrich/{sku}": {
      "get": {
        "tags": ["Consumidas"],
        "summary": "Consulta preço e estoque de um SKU",
        "description": "Latência de 400 a 800 ms. No máximo 3 requisições em voo: acima disso a plataforma responde 429 com `retry-after`. Falha transitória em cerca de 10% das chamadas (500). Nosso `enrich-client` aplica semáforo global de 3, retry com backoff nos 500 e respeita o `retry-after`.",
        "parameters": [
          { "name": "sku", "in": "path", "required": true, "schema": { "type": "string" }, "example": "sku-001" },
          { "name": "x-cid", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "x-token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Sucesso", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "sku": { "type": "string", "example": "sku-001" },
            "price": { "type": "number", "example": 149.9 },
            "stock": { "type": "integer", "example": 42 }
          } } } } },
          "401": { "description": "Credencial inválida (erro permanente, sem retry)" },
          "404": { "description": "SKU inválido (erro permanente, sem retry)" },
          "429": {
            "description": "Mais de 3 requisições simultâneas. Esperar o tempo do header `retry-after` e tentar de novo, sem contar como falha do item.",
            "headers": { "retry-after": { "schema": { "type": "integer" }, "description": "Segundos para aguardar" } }
          },
          "500": { "description": "Falha transitória (~10%). Retentar com backoff." }
        }
      }
    },
    "/callback": {
      "post": {
        "tags": ["Consumidas"],
        "summary": "Entrega o resultado consolidado do lote",
        "description": "Pode ser chamado várias vezes para o mesmo `run_id`; cada envio gera um novo relatório (score, ACK, idempotência, retry, concorrência e conferência do resultado). Nosso serviço envia uma única vez por lote, com os itens ordenados por `seq`.",
        "parameters": [
          { "name": "x-token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["cid", "run_id", "result"], "properties": {
            "cid": { "type": "string" },
            "run_id": { "type": "string" },
            "result": { "type": "array", "items": { "type": "object", "properties": {
              "seq": { "type": "integer", "example": 0 },
              "sku": { "type": "string", "example": "sku-001" },
              "price": { "type": "number", "example": 149.9 },
              "stock": { "type": "integer", "example": 42 }
            } } }
          } } } }
        },
        "responses": {
          "200": { "description": "Relatório da execução (score e detalhes por critério)", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "description": "Credencial inválida" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Credentials": {
        "type": "object",
        "properties": {
          "cid": { "type": "string", "example": "clx..." },
          "token": { "type": "string", "example": "a3f9..." }
        }
      }
    }
  }
}
